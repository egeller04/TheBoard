rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin panel data.
    // Only users who have successfully logged into Firebase
    // Authentication can read/write these documents.
    match /config/{document} {
      allow read, write: if request.auth != null;
    }

    match /punishments/{document} {
      allow read, write: if request.auth != null;
    }

    match /history/{document} {
      allow read, write: if request.auth != null;
    }
  }
}