rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    function isMember() {
      return request.auth != null && (isAdmin() || exists(/databases/$(database)/documents/members/$(request.auth.uid)));
    }
    match /members/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }
    match /invitations/{id} { allow read, write: if false; }
    match /{collection}/{id} {
      allow read: if collection in ['punishments', 'rotation', 'history', 'stats'] && isMember();
      allow write: if collection in ['punishments', 'rotation', 'history'] && isAdmin();
    }
    match /config/{id} {
      allow read: if (id == 'current' && isMember()) || isAdmin();
      allow write: if isAdmin();
    }
    match /stats/beerCounter {
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int && request.resource.data.count >= 0;
    }
  }
}
